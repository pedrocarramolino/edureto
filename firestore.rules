rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Each user can read their own role/profile doc. Roles are assigned
    // manually (Firebase console or a trusted backend), never by the
    // client, so students can't grant themselves "profesora" access.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // No other collections are exposed yet.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
