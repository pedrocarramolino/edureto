rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function mascotaValida() {
      return request.resource.data.saciedad is number
             && request.resource.data.saciedad >= 0 && request.resource.data.saciedad <= 100
             && request.resource.data.felicidad is number
             && request.resource.data.felicidad >= 0 && request.resource.data.felicidad <= 100
             && request.resource.data.energia is number
             && request.resource.data.energia >= 0 && request.resource.data.energia <= 100
             && request.resource.data.gastadas is number
             && request.resource.data.gastadas >= 0
             && request.resource.data.gastadas <= 1000000
             && request.resource.data.nombre is string
             && request.resource.data.nombre.size() <= 30
             && request.resource.data.tipo is string
             && request.resource.data.tipo.size() <= 30;
    }

    function isProfesora() {
      return request.auth != null
             && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "profesora";
    }

    // Each user can read their own role/profile doc, and a "profesora"
    // can also read every student profile (needed to list her students
    // in the dashboard). A user can create their own doc at signup
    // (self-service registration), but only with role "alumno" locked
    // in — "profesora" accounts are granted manually (Firebase console
    // or a trusted backend). No client updates/deletes, so a student
    // can't later rewrite their own role.
    match /users/{uid} {
      allow read: if request.auth != null && (
        request.auth.uid == uid ||
        isProfesora()
      );
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.role == "alumno"
                    && request.resource.data.keys().hasOnly([
                         "role", "name", "birthDate", "stage", "avatarEmoji", "createdAt"
                       ])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() <= 80
                    && request.resource.data.birthDate is string
                    && request.resource.data.birthDate.size() <= 10
                    && request.resource.data.avatarEmoji is string
                    && request.resource.data.avatarEmoji.size() <= 8
                    && request.resource.data.stage in [
                         "infantil", "primaria_inicial", "primaria_superior", "eso"
                       ];
      // Two narrow updates are allowed, each limited to a single field:
      // a student may add to their own "placementTestsTaken" list (which
      // subject placement tests they've already done), and a profesora may
      // correct a student's "stage" (their school year) from her panel.
      // Nothing else about the doc can be touched, so neither path can be
      // used to change role/name/email.
      allow update: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["placementTestsTaken"])
                    && request.resource.data.placementTestsTaken is list
                    && request.resource.data.placementTestsTaken.size() <= 40;
      allow update: if isProfesora()
                    && resource.data.role == "alumno"
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["stage"])
                    && request.resource.data.stage in [
                         "infantil", "primaria_inicial", "primaria_superior", "eso"
                       ];
      allow delete: if false;
    }

    // One document per finished game. A student can only write attempts for
    // themselves, and only ones that look like a real result; the teacher can
    // read everything so the dashboard can show each student's progress.
    // Nothing can be edited or deleted afterwards, so the history is a
    // trustworthy record.
    match /attempts/{attemptId} {
      allow read: if request.auth != null && (
        resource.data.studentId == request.auth.uid || isProfesora()
      );
      // Los límites de tamaño y de número existen para que nadie pueda inflar
      // su marcador ni llenar la base de datos escribiendo directamente
      // contra Firestore: ningún juego pasa de 30 preguntas.
      allow create: if request.auth != null
                    && request.resource.data.studentId == request.auth.uid
                    && request.resource.data.keys().hasOnly([
                         "studentId", "activityId", "activityTitle", "subjectId",
                         "topic", "stage", "correct", "correctCount", "totalCount",
                         "isPlacementTest", "completedAt"
                       ])
                    && request.resource.data.keys().hasAll([
                         "studentId", "activityId", "subjectId", "stage",
                         "correct", "correctCount", "totalCount",
                         "isPlacementTest", "completedAt"
                       ])
                    && request.resource.data.activityId is string
                    && request.resource.data.activityId.size() <= 60
                    && request.resource.data.activityTitle is string
                    && request.resource.data.activityTitle.size() <= 120
                    && request.resource.data.topic is string
                    && request.resource.data.topic.size() <= 80
                    && request.resource.data.subjectId is string
                    && request.resource.data.subjectId.size() <= 40
                    && request.resource.data.stage in [
                         "infantil", "primaria_inicial", "primaria_superior", "eso"
                       ]
                    && request.resource.data.correct is bool
                    && request.resource.data.isPlacementTest is bool
                    && request.resource.data.correctCount is number
                    && request.resource.data.totalCount is number
                    && request.resource.data.correctCount >= 0
                    && request.resource.data.correctCount <= request.resource.data.totalCount
                    && request.resource.data.totalCount > 0
                    && request.resource.data.totalCount <= 30
                    && request.resource.data.completedAt == request.time;
      allow update, delete: if false;
    }

    // La mascota de cada alumno. Solo su dueño la cuida; la profesora puede
    // verla. Las necesidades van de 0 a 100 y las monedas gastadas solo pueden
    // subir, para que nadie se "devuelva" monedas editando el documento.
    match /mascotas/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isProfesora());
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.ownerId == uid
                    && request.resource.data.keys().hasOnly([
                         "ownerId", "tipo", "nombre", "saciedad", "felicidad",
                         "energia", "gastadas", "ultimaVisita"
                       ])
                    && mascotaValida()
                    && request.resource.data.gastadas == 0
                    && request.resource.data.ultimaVisita == request.time;
      allow update: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                         "tipo", "nombre", "saciedad", "felicidad", "energia",
                         "gastadas", "ultimaVisita"
                       ])
                    && mascotaValida()
                    && request.resource.data.gastadas >= resource.data.gastadas
                    && request.resource.data.ultimaVisita == request.time;
      allow delete: if false;
    }

    // No other collections are exposed yet.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
